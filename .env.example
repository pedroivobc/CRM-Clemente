# ── Geral ────────────────────────────────────────────────────────────────
APP_ENV=development                # development | production
BASE_DOMAIN=localhost              # domínio base dos subdomínios de tenant (ex.: sistema.com.br)

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ── Banco (conexão direta usada pela API/worker) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# ── Redis / fila ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage local de desenvolvimento (fallback sem Supabase Storage) ────
LOCAL_STORAGE_DIR=./storage-dev

# ── Providers (Fase 2+; em dev os mocks são usados automaticamente) ─────
PAYMENT_PROVIDER=mock              # mock | asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
SIGNATURE_PROVIDER=mock            # mock | clicksign
CLICKSIGN_API_KEY=
INVOICE_PROVIDER=mock              # mock | focus_nfe
FOCUS_NFE_TOKEN=
MESSAGING_PROVIDER=mock            # mock | evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ── Frontend (Vite) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=changeme
VITE_API_URL=http://localhost:8000
